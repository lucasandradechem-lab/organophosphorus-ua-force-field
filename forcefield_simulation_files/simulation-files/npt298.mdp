; Run parameters
integrator              = md
dt                      = 0.002
nsteps                  = 15000000 
nstxtcout               = 10000
nstvout                 = 10000
nstfout                 = 10000
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
; Bond parameters
constraints             = all-bonds   
constraint-algorithm    = LINCS
continuation		= no
lincs_iter              = 1         
lincs_order             = 4        
; Nonbonded settings 
cutoff-scheme           = Verlet    
ns_type                 = grid     
nstlist                 = 10      
rcoulomb                = 1.4      
rvdw                    = 1.4      
rlist			= 1.4

; Electrostatics
coulombtype             = PME       
pme_order               = 4        
fourierspacing          = 0.16      

; Temperature coupling is on
tcoupl                  = V-rescale             
tc-grps                 = SYSTEM   
tau_t                   = 0.1             
ref_t                   = 298.15             
; Pressure coupling is on
pcoupl                  = C-rescale    
pcoupltype              = isotropic             
tau_p                   = 2.0                   
ref_p                   = 1.01325               
compressibility         = 4.5e-5                
refcoord_scaling        = com
; Periodic boundary conditions
pbc                     = xyz       
; Velocity generation
gen_vel                 =yes       
