; Run parameters
integrator              = md         
nsteps                  = 2000000      
dt                      = 0.002     
; Output control
nstxout-compressed	= 2000000        
nstvout                 = 2000000       
nstenergy               = 6        ; very frequent energy output necessary for accurate viscosity
nstlog                  = 200        

; Bond parameters
constraints             = all-bonds  
constraint-algorithm    = LINCS

lincs_iter              = 1         
lincs_order             = 4         
; Nonbonded settings 
cutoff-scheme           = Verlet    
ns_type                 = grid      
nstlist                 = 10        
rcoulomb                = 1.4       
rvdw                    = 1.4       
rlist			= 1.4

; Electrostatics
coulombtype             = PME      
pme_order               = 4        
fourierspacing          = 0.16      

; Temperature coupling is on
tcoupl                  = v-rescale            
tc-grps                 = SYSTEM  
tau_t                   = 5              
ref_t                   = 298.15            
; Pressure coupling is on
pcoupl                  = no    
; Periodic boundary conditions
pbc                     = xyz       
; Velocity generation
gen_vel                 = yes       
gen_temp		= 298.15
gen_seed		= -1
